# ── hbook configuration ─────────────────────────────────────────────
# Copy this file to .env and fill the values.

# PostgreSQL connection string.
#  - dedicated database:      postgresql://hbook:***@host:5432/hbook
#  - SHARED database, own schema (e.g. next to Homana):
#      postgresql://hbook_app:***@host:5432/homana?schema=hbook
#    (see docs/DEPLOY.md for the one-time role/grant setup)
# Tip: append &connection_limit=10&pool_timeout=10 for pool tuning.
DATABASE_URL=postgresql://hbook:hbook@localhost:5432/hbook?connection_limit=10

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Master token required to create tenants (POST /v1/tenants).
# NEVER expose this to the frontend — server-to-server only.
# Generate a strong one:  openssl rand -hex 32
HBOOK_SETUP_TOKEN=please-change-me-openssl-rand-hex-32

# REQUIRED in production. Encrypts webhook signing secrets at rest
# (AES-256-GCM). All engine instances MUST share the same value.
# Generate:  openssl rand -base64 32
HBOOK_WEBHOOK_ENC_KEY=

# CORS: comma-separated list of allowed origins. Empty = no CORS headers
# (recommended for pure server-to-server usage).
CORS_ORIGINS=

# Rate limiting (global, per API key or client IP)
RATE_LIMIT_MAX=300
# Failed authentications (bad/rotating keys) allowed per IP per minute
AUTH_FAIL_LIMIT=30

# Proxy handling: set true when behind nginx/traefik so client IPs are correct
# (rate limiting and the auth-failure limiter key on the real client IP).
TRUST_PROXY=false

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── webhook delivery worker ─────────────────────────────────────────
# Per-request timeout and bounded retry backoff (ms). Total attempts =
# number of backoff entries + 1. After the last failure the delivery row
# becomes FAILED and can be replayed via the API.
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_BACKOFF_MS=1000,4000,16000,64000
WEBHOOK_CONCURRENCY=5
WEBHOOK_TICK_MS=500
WEBHOOK_MAX_REDIRECTS=3

# ── TEST-ONLY escape hatches (never honored when NODE_ENV=production) ──
# Plain http webhook destinations
HBOOK_WEBHOOK_ALLOW_INSECURE_HTTP=0
# Private/loopback webhook destinations (e.g. a receiver on 127.0.0.1)
HBOOK_WEBHOOK_ALLOW_PRIVATE_IPS=0

# Idempotency-Key records are kept (and replayable) for this many hours
IDEMPOTENCY_TTL_HOURS=24
