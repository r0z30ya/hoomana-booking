{
  "name": "hbook",
  "version": "1.0.0",
  "description": "hbook — fast, secure, multi-tenant booking engine API inspired by cal.com / cal.diy (no frontend, API-only)",
  "license": "MIT",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:unit": "node --import tsx scripts/unit.mjs",
    "test:regression": "node scripts/regression.mjs",
    "test:e2e": "scripts/run-with-server.sh 3100 env BASE_URL=http://127.0.0.1:3100 HBOOK_SETUP_TOKEN=e2e-setup-token-0123456789abcdef node scripts/e2e.mjs",
    "test:multi": "node scripts/multi-instance.mjs",
    "test:shared-schema": "node scripts/verify-shared-schema.cjs",
    "test:fresh-install": "node scripts/verify-fresh-install.cjs",
    "test:load": "RATE_LIMIT_MAX=200000 AUTH_FAIL_LIMIT=100000 scripts/run-with-server.sh 3300 env BASE_URL=http://127.0.0.1:3300 node scripts/load.mjs 3300",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "booking",
    "scheduling",
    "appointments",
    "cal.com",
    "fastify",
    "prisma",
    "postgresql",
    "api"
  ],
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "prisma": "^6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
