{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Bundler target: Vite produces the artifact, tsc only type-checks. */
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "vite.config.ts"]
}
