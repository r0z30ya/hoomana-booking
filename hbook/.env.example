# ── hbook configuration ─────────────────────────────────────────────
# Copy this file to .env and fill the values.

# PostgreSQL connection string.
# Tip: append ?connection_limit=10&pool_timeout=10 for pool tuning.
DATABASE_URL=postgresql://hbook:hbook@localhost:5432/hbook?connection_limit=10

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Master token required to create tenants (POST /v1/tenants).
# Generate a strong one:  openssl rand -hex 32
HBOOK_SETUP_TOKEN=please-change-me-openssl-rand-hex-32

# CORS: comma-separated list of allowed origins. Empty = no CORS headers
# (recommended for pure server-to-server usage).
CORS_ORIGINS=

# Rate limiting (global, per API key or IP)
RATE_LIMIT_MAX=300

# Proxy handling: set true when behind nginx/traefik so client IPs are correct.
TRUST_PROXY=false

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
