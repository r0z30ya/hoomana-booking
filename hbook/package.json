{
  "name": "hbook",
  "version": "1.0.0",
  "description": "hbook — fast, secure, multi-tenant booking engine API inspired by cal.com / cal.diy (no frontend, API-only)",
  "license": "MIT",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "booking",
    "scheduling",
    "appointments",
    "cal.com",
    "fastify",
    "prisma",
    "postgresql",
    "api"
  ],
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "prisma": "^6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
