# HMN SaaS — local development infrastructure credentials.
#
# Copy this file to `.env` in the same directory and set a real password:
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit it. This stack is local development only;
# production uses managed services with credentials injected by the platform.

# --- PostgreSQL ---
POSTGRES_USER=hmn
POSTGRES_PASSWORD=
POSTGRES_DB=hmn_saas
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Application connection strings (consumed by apps/api and apps/worker in Phase 2) ---
# Fill POSTGRES_PASSWORD in, then these become valid as-is.
DATABASE_URL=postgresql://hmn:CHANGE_ME@127.0.0.1:5432/hmn_saas?schema=public
REDIS_URL=redis://127.0.0.1:6379
