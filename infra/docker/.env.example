# HMN SaaS — local development infrastructure credentials.
#
# Copy this file to `.env` in the same directory and set a real password:
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit it. This stack is local development only;
# production uses managed services with credentials injected by the platform.

# --- PostgreSQL ---
POSTGRES_USER=hmn
POSTGRES_PASSWORD=
POSTGRES_DB=hmn_saas
POSTGRES_PORT=5432

# --- ADR-0003 database role passwords ---
# Three roles are provisioned by initdb/10-create-roles.sh (run automatically on
# first volume init; see that script for re-applying to an existing cluster):
#   hmn_migrator  — Prisma CLI migrations only; NEVER used by API/worker runtime
#   hmn_app       — API/worker runtime connection (RLS-bound, non-owner)
#   hmn_platform  — audited platform operations (RLS-bound, non-owner)
# Generate hex values, e.g.:  openssl rand -hex 24
HMN_MIGRATOR_PASSWORD=
HMN_APP_PASSWORD=
HMN_PLATFORM_PASSWORD=

# --- Redis ---
REDIS_PORT=6379

# --- Connection strings (mirror infra/docker/.env; fill the passwords above) ---
# DATABASE_URL      -> hmn_migrator: Prisma CLI only (packages/db/prisma.config.ts)
# DATABASE_APP_URL  -> hmn_app: API/worker runtime (required at startup)
# DATABASE_PLATFORM_URL -> hmn_platform: audited platform operations/tests
DATABASE_URL=postgresql://hmn_migrator:CHANGE_ME@127.0.0.1:5432/hmn_saas?schema=public
DATABASE_APP_URL=postgresql://hmn_app:CHANGE_ME@127.0.0.1:5432/hmn_saas?schema=public
DATABASE_PLATFORM_URL=postgresql://hmn_platform:CHANGE_ME@127.0.0.1:5432/hmn_saas?schema=public
REDIS_URL=redis://127.0.0.1:6379
