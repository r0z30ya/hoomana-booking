# HMN SaaS — application environment (LOCAL DEVELOPMENT).
#
# Copy to `.env` in this same directory (repository root) and fill in the values:
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed.
#
# DATABASE_URL / REDIS_URL must point at the local Docker Compose stack in
# infra/docker. POSTGRES_PASSWORD below must equal the value in
# infra/docker/.env, otherwise the database connection will be rejected.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- apps/api HTTP server ---
# Loopback by default: local development should not expose the API on the LAN.
API_HOST=127.0.0.1
API_PORT=3001

# --- PostgreSQL (Docker Compose service `postgres`) ---
# Three roles per ADR-0003 D2 (passwords live in infra/docker/.env):
#   DATABASE_URL          -> hmn_migrator: Prisma CLI migrations ONLY.
#                            Never used by API/worker runtime; startup validation
#                            rejects it (see @hmn/db validateRuntimeDatabaseRole).
#   DATABASE_APP_URL      -> hmn_app: API/worker runtime connection (RLS-bound).
#   DATABASE_PLATFORM_URL -> hmn_platform: audited platform operations (RLS-bound).
DATABASE_URL=postgresql://hmn_migrator:CHANGE_ME@127.0.0.1:5432/hmn_saas?schema=public
DATABASE_APP_URL=postgresql://hmn_app:CHANGE_ME@127.0.0.1:5432/hmn_saas?schema=public
DATABASE_PLATFORM_URL=postgresql://hmn_platform:CHANGE_ME@127.0.0.1:5432/hmn_saas?schema=public

# --- Redis (Docker Compose service `redis`) ---
REDIS_URL=redis://127.0.0.1:6379
